{
  "apiVersion": 1,
  "id": "eidos.journals",
  "name": "%plugin.name%",
  "version": "0.6.0",
  "requires": {
    "pluginApi": "3.7.0"
  },
  "icon": {
    "paths": [
      "M8 2v4",
      "M16 2v4",
      "M3 10h18",
      "M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
      "m9 16 2 2 4-4"
    ]
  },
  "extension": "./src/extension.ts",
  "workspace": {
    "files": true
  },
  "views": [
    {
      "id": "overview",
      "title": "%views.overview.title%",
      "entry": "./src/page.ts",
      "kind": "page",
      "access": "write"
    }
  ],
  "settings": {
    "folder": {
      "type": "string",
      "title": "%settings.folder.title%",
      "description": "%settings.folder.description%",
      "default": "journals"
    },
    "organization": {
      "type": "string",
      "title": "%settings.organization.title%",
      "description": "%settings.organization.description%",
      "enum": [
        "YYYY-MM-DD.md",
        "YYYY/YYYY-MM-DD.md",
        "YYYY/MM/YYYY-MM-DD.md"
      ],
      "default": "YYYY/MM/YYYY-MM-DD.md"
    }
  },
  "actions": [
    {
      "id": "today",
      "title": "%actions.today.title%",
      "context": "workspace",
      "access": "write"
    },
    {
      "id": "overview",
      "title": "%actions.overview.title%",
      "context": "workspace"
    }
  ],
  "placements": [
    {
      "location": "navigation",
      "view": "overview"
    },
    {
      "location": "command-palette",
      "action": "today"
    },
    {
      "location": "command-palette",
      "action": "overview"
    }
  ],
  "description": "%plugin.description%",
  "i18n": {
    "defaultLocale": "en",
    "messages": {
      "en": "./locales/en.json",
      "zh-CN": "./locales/zh-CN.json"
    },
    "readme": {
      "en": "./README.md",
      "zh-CN": "./README.zh-CN.md"
    }
  }
}
